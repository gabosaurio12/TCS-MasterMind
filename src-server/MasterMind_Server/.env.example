# Template for the environment variables required by MasterMind_Server.
# Copy this file to .env, fill the values and never commit the real .env (it is gitignored).
# The server loads it with DotNetEnv (Env.Load) from Data/MasterMindModel.Context.Custom.cs
# and Services/CodeService.cs.

DB_SOURCE=(localdb)\MSSQLLocalDB
DB_NAME=MasterMind
DB_USER=MasterMind_Login
DB_PASSWORD=

SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_LOGIN=
SMTP_KEY=
SMTP_SENDER=mastermind@example.com