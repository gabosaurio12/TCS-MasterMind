<Window x:Class="MasterMind_Client.Modals.MatchMenuModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:MasterMind_Client.Properties"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Title="{x:Static p:Resources.MatchMenu_Title}" Height="493" Width="660"
        Background="{StaticResource ModalMatchMenuBgBrush}"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ResumeCommand}" />
    </Window.InputBindings>

    <Grid>
        <Viewbox VerticalAlignment="Top" StretchDirection="DownOnly" Margin="220,58,220,0" Height="66">
            <Label x:Name="ModalTitleLbl" Content="{x:Static p:Resources.MatchMenu_Title}"
                   FontFamily="{StaticResource Elite}" Foreground="{StaticResource CreamBrush}"
                   FontSize="48" />
        </Viewbox>

        <Button x:Name="MusicBtn" Content="{x:Static p:Resources.MatchMenu_Music}"
                Style="{StaticResource MetalButtonBlue}" IsEnabled="False"
                Width="230" Height="72" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,162,0,0" FontFamily="{StaticResource Elite}" FontSize="26" />

        <Button x:Name="ResumeBtn" Content="{x:Static p:Resources.MatchMenu_Resume}"
                Style="{StaticResource MetalButtonBlue}"
                Width="230" Height="72" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,264,0,0" FontFamily="{StaticResource Elite}" FontSize="30"
                Command="{Binding ResumeCommand}" />

        <Button x:Name="ExitGameBtn" Content="{x:Static p:Resources.MatchMenu_ExitGame}"
                Style="{StaticResource MetalButtonRed}"
                Width="300" Height="72" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,365,0,0" FontFamily="{StaticResource Elite}" FontSize="30"
                Command="{Binding ExitCommand}" />
    </Grid>
</Window>
