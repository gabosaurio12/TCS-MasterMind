<Window x:Class="MasterMind_Client.Modals.GameOverTriesModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:MasterMind_Client.Properties"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Title="{x:Static p:Resources.GameOverTriesModal_Title}" Height="493" Width="660"
        Background="{StaticResource ModalEndGameBgBrush}"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Grid>
        <Viewbox VerticalAlignment="Top" StretchDirection="DownOnly" Margin="100,56,100,0" Height="60">
            <Label x:Name="ModalTitleLbl" Content="{Binding Title}"
                   FontFamily="{StaticResource Elite}" Foreground="{StaticResource CreamBrush}"
                   FontSize="40" />
        </Viewbox>

        <Viewbox VerticalAlignment="Center" StretchDirection="DownOnly" Margin="70,0,70,0" Height="120">
            <Label x:Name="GameOverLbl" Content="{x:Static p:Resources.GameOverModal_GameOver}"
                   FontFamily="{StaticResource Elite}" Foreground="{StaticResource CreamBrush}"
                   FontSize="96" />
        </Viewbox>

        <Button x:Name="ContinueBtn" Content="{x:Static p:Resources.UI_Continue}"
                Style="{StaticResource MetalButtonBlue}"
                Width="250" Height="76" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,56" FontFamily="{StaticResource Elite}" FontSize="32"
                Command="{Binding ContinueCommand}" />
    </Grid>
</Window>
