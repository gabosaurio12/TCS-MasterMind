<Window x:Class="MasterMind_Client.Modals.LogOutModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterMind_Client.Modals"
        mc:Ignorable="d"
        WindowStyle="None"
        xmlns:p="clr-namespace:MasterMind_Client.Properties"
        Title="{x:Static p:Resources.LogOutModal_Title}" Height="376" Width="670"
        Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Border CornerRadius="25"
        Background="#313539"
        BorderBrush="Black"
        BorderThickness="5">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label x:Name="ModalTitleLbl" Grid.Row="0"
                   Content="{x:Static p:Resources.LogOutModal_Title}"
                   FontFamily="{StaticResource Aladin}" Foreground="White"
                   FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center">
                <Button x:Name="QuitBtn" Style="{StaticResource ModalRedButton}"
                        Content="{x:Static p:Resources.UI_Quit}" Width="250" Height="88"
                        FontFamily="{StaticResource Aladin}" FontSize="48"
                        Margin="0,0,30,0" Command="{Binding QuitCommand}"/>

                <Button x:Name="LogOutBtn" Style="{StaticResource ModalButton}"
                        Content="{x:Static p:Resources.LogOutModal_LogOut}"
                        Width="250" Height="88" Margin="30,0,0,0"
                        FontFamily="{StaticResource Aladin}" FontSize="48"
                        Command="{Binding LogOutCommand}"/>
            </StackPanel>
        </Grid>

    </Border>
</Window>
