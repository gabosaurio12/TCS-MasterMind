<Window x:Class="MasterMind_Client.Modals.LogOutModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterMind_Client.Modals"
        mc:Ignorable="d"
        WindowStyle="None"
        xmlns:p="clr-namespace:MasterMind_Client.Properties"
        Title="{x:Static p:Resources.LogOutModal_Title}" Height="417" Width="670"
        Background="{StaticResource ModalLogOutBgBrush}"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Grid Margin="40,46,40,42">
        <Viewbox Stretch="Uniform">
            <StackPanel>

                <Label x:Name="ModalTitleLbl" Content="{x:Static p:Resources.LogOutModal_Title}"
                       HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                       FontFamily="{StaticResource Elite}" Foreground="{StaticResource CreamBrush}"
                       FontSize="38" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,100,0,0">
                    <Button x:Name="QuitBtn" Content="{x:Static p:Resources.UI_Quit}"
                            Style="{StaticResource MetalButtonRed}"
                            Width="250" Height="88" Padding="10,0" Margin="0,0,30,0"
                            FontFamily="{StaticResource Elite}" FontSize="30"
                            Command="{Binding QuitCommand}" />

                    <Button x:Name="LogOutBtn" Content="{x:Static p:Resources.LogOutModal_LogOut}"
                            Style="{StaticResource MetalButtonBlue}"
                            Width="250" Height="88" Padding="10,0"
                            FontFamily="{StaticResource Elite}" FontSize="30"
                            Command="{Binding LogOutCommand}" />
                </StackPanel>

            </StackPanel>
        </Viewbox>
    </Grid>
</Window>
