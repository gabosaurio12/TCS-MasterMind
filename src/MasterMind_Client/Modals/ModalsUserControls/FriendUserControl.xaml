<UserControl x:Class="MasterMind_Client.Modals.ModalsUserControls.FriendUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MasterMind_Client.Modals.ModalsUserControls"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="560">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Width="100" Height="100"
              HorizontalAlignment="Center" VerticalAlignment="Center">

            <Ellipse Width="80" Height="80">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{StaticResource AvatarImage}" Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse x:Name="OnlineVisibility" Width="20" Height="20" Margin="0,0,4,4"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Fill="{Binding OnlineBrush}"
                     Stroke="{StaticResource FrameMetalBrush}" StrokeThickness="4" />
        </Grid>

        <Viewbox Grid.Column="1" StretchDirection="DownOnly" MaxHeight="70"
                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,8,0">
            <TextBlock x:Name="UsernameTxt" FontFamily="{StaticResource Elite}" FontSize="60"
                       Foreground="{StaticResource CreamBrush}" Text="{Binding Username}" />
        </Viewbox>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

            <Button x:Name="InviteBtn" Style="{StaticResource MetalButtonPlus}"
                    Width="45" Height="45" Padding="0" />

            <Button x:Name="RemoveFriend" Style="{StaticResource MetalButtonMinus}"
                    Width="45" Height="45" Padding="0" Margin="16,0,0,0" />
        </StackPanel>

    </Grid>
</UserControl>
