<UserControl x:Class="MasterMind_Client.Modals.ModalsUserControls.FriendUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MasterMind_Client.Modals.ModalsUserControls"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="520">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="75" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>

        <Ellipse x:Name="OnlineVisibility" Grid.Column="0" Width="50" Height="50" Fill="#929292" />

        <Viewbox Grid.Column="1" StretchDirection="DownOnly" MaxHeight="55" HorizontalAlignment="Left">
            <TextBlock x:Name="UsernameTxt" FontFamily="{StaticResource Aladin}" FontSize="50"
                       Foreground="White"/>
        </Viewbox>

        <StackPanel Grid.Column="2" Orientation="Horizontal" >
            <Button x:Name="InviteBtn" Width="45" Height="45"
                    Style="{StaticResource UserControlMiniBlueButton}"
                    Content="+" FontFamily="{StaticResource Aladin}"
                    FontSize="40" Margin="0,0,5,0" />

            <Button x:Name="RemoveFriend" Width="45" Height="45"
                    Style="{StaticResource UserControlMiniRedButton}"
                    Content="+" FontFamily="{StaticResource Aladin}"
                    FontSize="40" Margin="5,0,0,0" />
        </StackPanel>
        
    </Grid>
</UserControl>
