<Window x:Class="MasterMind_Client.Modals.ChangePasswordModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterMind_Client.Modals"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        xmlns:p="clr-namespace:MasterMind_Client.Properties"
        Title="{x:Static p:Resources.NewPasswordModal_Title}" Height="493" Width="660"
        Background="{StaticResource ModalVerificationBgBrush}"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <!-- Margin keeps the content inside the metal frame of the panel -->
    <Grid Margin="40,50,40,50">
        <Viewbox Stretch="Uniform">
            <StackPanel>

                <Label x:Name="ModalTitleLbl" Content="{x:Static p:Resources.NewPasswordModal_Title}"
                       HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                       FontFamily="{StaticResource Elite}" Foreground="{StaticResource CreamBrush}"
                       FontSize="20" />

                <Label x:Name="PasswordLbl" Content="{x:Static p:Resources.Player_Password}"
                       HorizontalAlignment="Center" Margin="0,30,0,0"
                       FontFamily="{StaticResource Elite}" Foreground="{StaticResource CreamBrush}"
                       FontSize="18" />

                <TextBox x:Name="PasswordTxt" Style="{StaticResource LongMetalTextBox}"
                         FontFamily="{StaticResource Elite}" FontSize="26"
                         Width="400" Height="80" Margin="0,12,0,0"
                         Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,56,0,0">
                    <Button x:Name="CancelBtn" Content="{x:Static p:Resources.UI_Cancel}"
                            Style="{StaticResource MetalButtonRed}"
                            Width="175" Height="52" Margin="0,0,30,0"
                            FontFamily="{StaticResource Elite}" FontSize="24"
                            Command="{Binding CancelCommand}" />

                    <Button x:Name="SaveBtn" Content="{x:Static p:Resources.UI_Save}"
                            Style="{StaticResource MetalButtonBlue}"
                            Width="175" Height="52"
                            FontFamily="{StaticResource Elite}" FontSize="24"
                            Command="{Binding SaveCommand}" />
                </StackPanel>

            </StackPanel>
        </Viewbox>
    </Grid>
</Window>
