<Window x:Class="MasterMind_Client.Modals.YouWonTriesModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:MasterMind_Client.Helpers"
        xmlns:p="clr-namespace:MasterMind_Client.Properties"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Title="{x:Static p:Resources.YouWonModal_Title}" Height="493" Width="660"
        Background="{StaticResource ModalEndGameBgBrush}"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <helpers:PinColourToImageConverter x:Key="PinColourToImage" />
    </Window.Resources>

    <Grid>
        <Viewbox VerticalAlignment="Top" StretchDirection="DownOnly" Margin="170,56,170,0" Height="60">
            <Label x:Name="ModalTitleLbl" Content="{x:Static p:Resources.YouWonModal_Title}"
                   FontFamily="{StaticResource Elite}" Foreground="{StaticResource CreamBrush}"
                   FontSize="48" />
        </Viewbox>

        <Viewbox VerticalAlignment="Top" StretchDirection="DownOnly" Margin="70,170,70,0" Height="60">
            <Label x:Name="SecretCodeLbl" Content="{x:Static p:Resources.YouWonTriesModal_SecretCode}"
                   FontFamily="{StaticResource Elite}" Foreground="{StaticResource CreamBrush}"
                   FontSize="44" />
        </Viewbox>

        <ItemsControl x:Name="SecretCodeList" ItemsSource="{Binding SecretCode}"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,250,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Width="78" Height="78" Margin="8,0">
                        <Image Source="{DynamicResource ColourPinEmptyImage}" Stretch="Uniform" />
                        <Image Source="{Binding Converter={StaticResource PinColourToImage}}"
                               Stretch="Uniform" Margin="4" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button x:Name="ContinueBtn" Content="{x:Static p:Resources.UI_Continue}"
                Style="{StaticResource MetalButtonBlue}"
                Width="250" Height="76" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,56" FontFamily="{StaticResource Elite}" FontSize="32"
                Command="{Binding ContinueCommand}" />
    </Grid>
</Window>
