<Window x:Class="MasterMind_Client.Modals.FriendRequestsModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterMind_Client.Modals"
        xmlns:controls="clr-namespace:MasterMind_Client.Modals.ModalsUserControls"
        mc:Ignorable="d"
        WindowStyle="None"
        xmlns:p="clr-namespace:MasterMind_Client.Properties"
        Title="{x:Static p:Resources.FriendRequestsModal_Title}" Height="857" Width="628"
        Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Border CornerRadius="25"
            Background="#313539"
            BorderBrush="Black"
            BorderThickness="5">

        <Viewbox Stretch="Uniform">
            <Grid Height="840" Width="500">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                    <RowDefinition Height="550" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Label x:Name="ModalTitleLbl" Grid.Row="0" Content="{x:Static p:Resources.FriendRequestsModal_Title}"
                       Foreground="White" FontFamily="{StaticResource Aladin}" FontSize="60"
                       HorizontalAlignment="Center"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FriendRequestsStack" ItemsSource="{Binding Requests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:FriendRequestUserControl Margin="0,0,0,10" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>


                <StackPanel Grid.Row="2" Orientation="Vertical" VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">
                        <Viewbox StretchDirection="DownOnly" MaxHeight="55">

                            <TextBox x:Name="AddreseeUsernameTxt" Height="60" Width="496"
                                     Style="{StaticResource RoundedTextBox}" FontSize="42"
                                     Text="{Binding AddresseeUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource Aladin}" Foreground="Gray"
                                     GotFocus="AddreseeUsernameTxt_GotFocus" LostFocus="AddreseeUsernameTxt_LostFocus" />
                        </Viewbox>

                        <Button x:Name="SendFriendRequestBtn" Width="45" Height="45"
                                Style="{StaticResource ModalGreenButton}" FontFamily="{StaticResource Aladin}"
                                FontSize="40" Content="+"
                                Command="{Binding SendCommand}"/>
                    </StackPanel>


                    <Button x:Name="CloseBtn" Content="{x:Static p:Resources.UI_Close}"
                            FontFamily="{StaticResource Aladin}" Style="{StaticResource ModalButton}"
                            Width="120" Height="45" FontSize="32" Margin="10"
                            Command="{Binding CloseCommand}" />
                </StackPanel>

            </Grid>


        </Viewbox>

    </Border>

</Window>
