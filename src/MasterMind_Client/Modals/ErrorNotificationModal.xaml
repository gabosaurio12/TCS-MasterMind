<Window x:Class="MasterMind_Client.Modals.ErrorNotificationModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterMind_Client.Modals"
        mc:Ignorable="d"
        WindowStyle="None"
        xmlns:p="clr-namespace:MasterMind_Client.Properties"
        Title="{x:Static p:Resources.ErrorNotification_Title}" Height="493" Width="660"
        Background="{StaticResource ModalErrorBgBrush}"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <!-- Margin keeps the content inside the metal frame of the panel -->
    <Grid Margin="40,46,40,42">
        <Viewbox Stretch="Uniform">
            <StackPanel>

                <Label x:Name="ModalTitleLbl" Content="{x:Static p:Resources.ErrorNotification_Title}"
                       HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                       FontFamily="{StaticResource Elite}" Foreground="{StaticResource CreamBrush}"
                       FontSize="56" />

                <TextBlock x:Name="NotificationMessageTxt" Text="{Binding Message}"
                           Width="500" Margin="0,60,0,60"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           FontFamily="{StaticResource Elite}" Foreground="{StaticResource CreamBrush}"
                           FontSize="44" />

                <Button x:Name="ContinueBtn" Content="{x:Static p:Resources.UI_Continue}"
                        Style="{StaticResource MetalButtonRed}"
                        Width="230" Height="85" HorizontalAlignment="Center"
                        FontFamily="{StaticResource Elite}" FontSize="40"
                        Command="{Binding ContinueCommand}" />
            </StackPanel>
        </Viewbox>
    </Grid>
</Window>