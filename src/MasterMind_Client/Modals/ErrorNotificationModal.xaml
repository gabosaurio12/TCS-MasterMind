<Window x:Class="MasterMind_Client.Modals.ErrorNotificationModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterMind_Client.Modals"
        mc:Ignorable="d"
        xmlns:p="clr-namespace:MasterMind_Client.Properties"
        Title="{x:Static p:Resources.ErrorNotification_Title}" Height="470" Width="660"
        Background="#452222" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" >

    <Viewbox Stretch="Uniform">
        <StackPanel>

            <Label x:Name="ModalTitleLbl" Content="{x:Static p:Resources.ErrorNotification_Title}"
               Margin="20" VerticalAlignment="Center"
               Width="345" HorizontalAlignment="Center" HorizontalContentAlignment="Center"
               FontFamily="{StaticResource Aladin}" Foreground="White" FontSize="64" />

            <TextBlock x:Name="NotificationMessageTxt" Text="{x:Static p:Resources.NotificationModal_DefaultMessage}"
                   Width="525" TextAlignment="Center" Margin="20" VerticalAlignment="Center"
                   FontFamily="{StaticResource Aladin}" Foreground="White" FontSize="32"
                   TextWrapping="Wrap"/>

            <Button x:Name="ContinueBtn" Content="{x:Static p:Resources.UI_Continue}"
                Width="150" Height="52" Style="{StaticResource ModalButton}"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                FontFamily="{StaticResource Aladin}" FontSize="32" Margin="20"
                Click="ContinueBtn_Click"/>
        </StackPanel>
    </Viewbox>
</Window>
