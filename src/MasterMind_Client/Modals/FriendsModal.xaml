<Window x:Class="MasterMind_Client.Modals.FriendsModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterMind_Client.Modals"
        xmlns:controls="clr-namespace:MasterMind_Client.Modals.ModalsUserControls"
        mc:Ignorable="d"
        WindowStyle="None"
        xmlns:p="clr-namespace:MasterMind_Client.Properties"
        Title="{x:Static p:Resources.FriendsModal_Title}" Height="857" Width="628"
        Background="{StaticResource ModalFriendsBgBrush}"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <!-- Margin keeps the content inside the metal frame of the panel -->
    <Grid Margin="34,44,34,40">
        <Viewbox Stretch="Uniform">
            <Grid Width="560" Height="773">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label x:Name="ModalTitleLbl" Grid.Row="0" Content="{x:Static p:Resources.FriendsModal_Title}"
                       Style="{StaticResource MetalTitleLbl}"
                       FontFamily="{StaticResource Elite}" FontSize="72" />

                <ScrollViewer Grid.Row="1" Margin="0,30,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FriendsStack" ItemsSource="{Binding Friends}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:FriendUserControl Margin="0,0,0,20" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="ButtonsStack" Grid.Row="2" Margin="0,30,0,0"
                            Orientation="Vertical" HorizontalAlignment="Center">

                    <Button x:Name="FriendRequestsBtn" Style="{StaticResource MetalButtonBlue}"
                            Width="440" Height="88"
                            FontFamily="{StaticResource Elite}" FontSize="28"
                            Content="{x:Static p:Resources.FriendRequestsModal_Title}"
                            Command="{Binding FriendRequestsCommand}" />

                    <Button x:Name="CloseBtn" Style="{StaticResource MetalButtonBlue}"
                            Width="230" Height="88" Margin="0,26,0,0"
                            FontFamily="{StaticResource Elite}" FontSize="42"
                            Content="{x:Static p:Resources.UI_Close}"
                            Command="{Binding CloseCommand}" />
                </StackPanel>

            </Grid>
        </Viewbox>
    </Grid>
</Window>