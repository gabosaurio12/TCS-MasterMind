<Window x:Class="MasterMind_Client.Modals.FriendsModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterMind_Client.Modals"
        xmlns:controls="clr-namespace:MasterMind_Client.Modals.ModalsUserControls"
        mc:Ignorable="d"
        WindowStyle="None"
        xmlns:p="clr-namespace:MasterMind_Client.Properties"
        Title="{x:Static p:Resources.FriendsModal_Title}" Height="857" Width="628"
        Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Border CornerRadius="25"
            Background="#313539"
            BorderBrush="Black"
            BorderThickness="5">

        <Viewbox Stretch="Uniform">
            <Grid Height="840" Width="500">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                    <RowDefinition Height="550" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Label x:Name="ModalTitleLbl" Grid.Row="0" Content="{x:Static p:Resources.FriendsModal_Title}"
               Foreground="White" FontFamily="{StaticResource Aladin}" FontSize="72"
               HorizontalAlignment="Center"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FriendsStack" ItemsSource="{Binding Friends}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:FriendUserControl Margin="0,0,0,10" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="ButtonsStack" Grid.Row="2" Orientation="Vertical" VerticalAlignment="Center">
                    <Button x:Name="FriendRequestsBtn" Content="{x:Static p:Resources.FriendRequestsModal_Title}"
                    FontFamily="{StaticResource Aladin}" Style="{StaticResource ModalButton}"
                    Width="300" Height="45" FontSize="32" Margin="10"
                    Command="{Binding FriendRequestsCommand}"/>

                    <Button x:Name="CloseBtn" Content="{x:Static p:Resources.UI_Close}"
                    FontFamily="{StaticResource Aladin}" Style="{StaticResource ModalButton}"
                    Width="120" Height="45" FontSize="32" Margin="10"
                    Command="{Binding CloseCommand}"/>
                </StackPanel>

            </Grid>


        </Viewbox>

    </Border>

</Window>
