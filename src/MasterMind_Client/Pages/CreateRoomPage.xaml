<Page x:Class="MasterMind_Client.Pages.CreateRoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MasterMind_Client.Pages"
      mc:Ignorable="d" 
      xmlns:p="clr-namespace:MasterMind_Client.Properties"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="{x:Static p:Resources.CreateRoomPage_Title}"
      Background="#585858">

    <Grid Width="1500">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="650" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" x:Name="PageTitleLbl" Content="{x:Static p:Resources.CreateRoomPage_Title}"
               FontFamily="{StaticResource Aladin}" FontSize="112" Foreground="White"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Form Grid -->
        <Grid Grid.Row="1" Background="#313539">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="400" />
            </Grid.RowDefinitions>

            <!-- Form Grid Row 0 -->
            <StackPanel Grid.Row="0">
                <Label x:Name="RoomNameLbl"
                       Content="{x:Static p:Resources.CreateRoomPage_Name}"
                       FontFamily="{StaticResource Aladin}" Foreground="White"
                       FontSize="64" Margin="66,15,0,15"/>

                <TextBox x:Name="RoomNameTxt"
                         Width="1400" Height="94" Foreground="White"
                         FontFamily="{StaticResource Aladin}"
                         FontSize="78"
                         Style="{StaticResource RoundedDarkTextBox}" />
            </StackPanel>
            
            <!-- ButtonsGrid -->

            <Grid Grid.Row="1" Margin="55,0,55,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ButtonsGrid Column0-->

                <StackPanel Grid.Column="0">

                    <!-- Gamemode Stack -->
                    <StackPanel HorizontalAlignment="Left">
                        <Label x:Name="GamemodeLbl"
                               Content="{x:Static p:Resources.CreateRoomPage_Mode}"
                               FontFamily="{StaticResource Aladin}" Foreground="White"
                               FontSize="64" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TimeTrialBtn" Content="{x:Static p:Resources.Gamemode_TimeTrial}"
                                    Style="{StaticResource ModalButton}" FontFamily="{StaticResource Aladin}"
                                    Width="250" Height="64" FontSize="48"
                                    Margin="0,0,40,0" Click="TimeTrialBtn_Click"/>

                            <Button x:Name="TriesBtn" Content="{x:Static p:Resources.Gamemode_Tries}"
                                    Style="{StaticResource ModalButton}" FontFamily="{StaticResource Aladin}"
                                    Width="250" Height="64" FontSize="48"
                                    Click="TriesBtn_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- PrivacyStack -->
                    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Left">
                        <Label x:Name="PrivacyLbl"
                               Content="{x:Static p:Resources.CreateRoomPage_Privacy}"
                               FontFamily="{StaticResource Aladin}" Foreground="White"
                               FontSize="64" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PrivateBtn" Content="{x:Static p:Resources.RoomPrivacy_Private}"
                                    Style="{StaticResource ModalRedButton}" FontFamily="{StaticResource Aladin}"
                                    Width="250" Height="64" FontSize="48"
                                    Margin="0,0,40,0" Click="PrivateBtn_Click"/>

                            <Button x:Name="PublicBtn" Content="{x:Static p:Resources.RoomPrivacy_Public}"
                                    Style="{StaticResource ModalButton}" FontFamily="{StaticResource Aladin}"
                                    Width="250" Height="64" FontSize="48"
                                    Click="PublicBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ButtonsGrid Column 1 -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <Label x:Name="DifficultyLbl"
                           Content="{x:Static p:Resources.CreateRoomPage_Difficulty}"
                           FontFamily="{StaticResource Aladin}" Foreground="White"
                           FontSize="64" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="EasyBtn" Content="{x:Static p:Resources.GameDifficulty_Easy}"
                                    Style="{StaticResource ModalButton}" FontFamily="{StaticResource Aladin}"
                                    Width="200" Height="64" FontSize="48"
                                    Margin="0,0,40,0" Click="EasyBtn_Click"/>

                            <Button x:Name="NormalBtn" Content="{x:Static p:Resources.GameDifficulty_Normal}"
                                    Style="{StaticResource ModalYellowButton}" FontFamily="{StaticResource Aladin}"
                                    Width="200" Height="64" FontSize="48"
                                    Margin="0,0,40,0" Click="NormalBtn_Click"/>

                            <Button x:Name="HardBtn" Content="{x:Static p:Resources.GameDifficulty_Hard}"
                                    Style="{StaticResource ModalOrangeButton}" FontFamily="{StaticResource Aladin}"
                                    Width="200" Height="64" FontSize="48"
                                    Click="HardBtn_Click"/>
                        </StackPanel>

                        <Button x:Name="Enigmabtn" Content="{x:Static p:Resources.GameDifficulty_Enigma}"
                                Style="{StaticResource ModalRedButton}" FontFamily="{StaticResource Aladin}"
                                Width="200" Height="64" FontSize="48"
                                Margin="0,40,0,0" Click="Enigmabtn_Click" />
                    </StackPanel>




                </StackPanel>
            </Grid>
        </Grid>
        
        <!-- Buttons -->

        <Button x:Name="CancelBtn" Grid.Row="2"
                HorizontalAlignment="Left"
                Content="{x:Static p:Resources.UI_Cancel}"
                Width="280" Height="100"
                Foreground="White" FontSize="64"
                FontFamily="{StaticResource Aladin}"
                Style="{StaticResource RoundedRedButton}"
                Click="CancelBtn_Click" />

        <Button x:Name="CreateBtn" Grid.Row="2"
                HorizontalAlignment="Right"
                Content="{x:Static p:Resources.UI_Create}"
                Width="280" Height="100"
                Foreground="White" FontSize="64"
                FontFamily="{StaticResource Aladin}"
                Style="{StaticResource RoundedGreenButton}"
                Click="CreateBtn_Click" />
    </Grid>
</Page>
