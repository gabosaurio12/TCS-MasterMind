<Page x:Class="MasterMind_Client.Pages.RoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MasterMind_Client.Pages"
      mc:Ignorable="d" 
      xmlns:p="clr-namespace:MasterMind_Client.Properties"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="{x:Static p:Resources.RoomsPage_Title}"
      Background="#585858">

    <Grid Width="1400">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="650" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" x:Name="PageTitleLbl" Content="{x:Static p:Resources.RoomsPage_Title}"
               FontFamily="{StaticResource Aladin}" FontSize="112" Foreground="White"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RoomsStack"  Background="#313539">

            </StackPanel>
        </ScrollViewer>
        

        <!-- Buttons -->

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Button x:Name="BackBtn" Grid.Row="2"
                    Content="{x:Static p:Resources.UI_Back}"
                    Width="280" Height="100" Margin="0,0,50,0"
                    Foreground="White" FontSize="64"
                    FontFamily="{StaticResource Aladin}"
                    Style="{StaticResource RoundedRedButton}"
                    Click="BackBtn_Click" />

            <Button x:Name="JoinBtn" Grid.Row="2"
                    Content="{x:Static p:Resources.RoomsPage_Join}"
                    Width="280" Height="100" Margin="0,0,50,0"
                    Foreground="White" FontSize="64"
                    FontFamily="{StaticResource Aladin}"
                    Style="{StaticResource RoundedButton}"
                    Click="JoinBtn_Click" />

            <Button x:Name="CodeBtn" Grid.Row="2"
                    Content="{x:Static p:Resources.RoomsPage_Code}"
                    Width="280" Height="100" Margin="0,0,50,0"
                    Foreground="White" FontSize="64"
                    FontFamily="{StaticResource Aladin}"
                    Style="{StaticResource RoundedButton}"
                    Click="CodeBtn_Click" />

            <Button x:Name="CreateBtn" Grid.Row="2"
                    Content="{x:Static p:Resources.UI_Create}"
                    Width="280" Height="100"
                    Foreground="White" FontSize="64"
                    FontFamily="{StaticResource Aladin}"
                    Style="{StaticResource RoundedGreenButton}"
                    Click="CreateBtn_Click" />
        </StackPanel>

        
    </Grid>
</Page>
