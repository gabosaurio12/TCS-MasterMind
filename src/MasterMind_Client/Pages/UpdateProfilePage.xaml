<Page x:Class="MasterMind_Client.Pages.UpdateProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MasterMind_Client.Pages"
      mc:Ignorable="d" 
      xmlns:p="clr-namespace:MasterMind_Client.Properties"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="{x:Static p:Resources.MainPage_Profile}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Backgrounds -->
        <Rectangle Grid.Column="0" Fill="{StaticResource BgLeftPanelGreenBrush}" />
        <Rectangle Grid.Column="1" Fill="{StaticResource BgRightPanelBrush}" />

        <!-- Left panel: avatar, editable player data and action buttons -->
        <Grid Grid.Column="0" Margin="40,50,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Width="292" Height="292"
                  HorizontalAlignment="Center" Margin="0,10,0,20">
                <Ellipse x:Name="Avatar" Width="292" Height="292"
                         Stroke="{StaticResource FrameMetalBrush}" StrokeThickness="12">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="AvatarImg"
                                    ImageSource="{StaticResource AvatarImage}"
                                    Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>

                <Image x:Name="EditAvatarImg" Source="{StaticResource EditAvatarIconImage}"
                       Width="130" Height="130" Stretch="Uniform"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,-65,-65" />
            </Grid>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Label x:Name="UsernameLbl" Content="{x:Static p:Resources.Player_Username}"
                       Style="{StaticResource MetalFieldLbl}"
                       FontFamily="{StaticResource Elite}" FontSize="56" />

                <TextBox x:Name="PlayerUsernameTxt" Style="{StaticResource LongMetalTextBox}"
                         FontFamily="{StaticResource Elite}" FontSize="40"
                         Width="600" Height="80" Margin="0,10,0,30"
                         Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Label x:Name="EmailLbl" Content="{x:Static p:Resources.Player_Email}"
                       Style="{StaticResource MetalFieldLbl}"
                       FontFamily="{StaticResource Elite}" FontSize="56" />

                <TextBox x:Name="PlayerEmailTxt" Style="{StaticResource LongMetalTextBox}"
                         FontFamily="{StaticResource Elite}" FontSize="40"
                         Width="600" Height="80" Margin="0,10,0,0"
                         Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Button x:Name="SaveBtn" Style="{StaticResource MetalButtonBlue}"
                        FontFamily="{StaticResource Elite}" FontSize="46"
                        Width="356" Height="115" Margin="0,0,0,24"
                        Content="{x:Static p:Resources.UpdateProfilePage_Save}"
                        Command="{Binding SaveCommand}" />

                <Button x:Name="CancelBtn" Style="{StaticResource MetalButtonRed}"
                        FontFamily="{StaticResource Elite}" FontSize="46"
                        Width="356" Height="115"
                        Content="{x:Static p:Resources.UI_Cancel}"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </Grid>

        <!-- Right panel: records, report field and back button -->
        <Grid Grid.Column="1" Margin="60,50,60,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="200" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Viewbox Grid.Row="0" Stretch="Fill" StretchDirection="DownOnly" MaxHeight="150">
                <Label x:Name="RecordsLbl" Content="{x:Static p:Resources.ProfilePage_Records}"
                       Style="{StaticResource MetalTitleLbl}"
                       FontFamily="{StaticResource Elite}" FontSize="140" />
            </Viewbox>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,34">
                    <Label x:Name="BestTimeLbl" Content="{x:Static p:Resources.ProfilePage_BestTime}"
                           FontFamily="{StaticResource Elite}" FontSize="38"
                           Foreground="{StaticResource CreamBrush}" />

                    <Label x:Name="PlayerBestTimeLbl" Content="{Binding BestTimeText}"
                           FontFamily="{StaticResource Elite}" FontSize="38"
                           Foreground="{StaticResource CreamMutedBrush}" Margin="14,0,0,0" />

                    <Label x:Name="SecondsLbl" Content="{x:Static p:Resources.ProfilePage_Seconds}"
                           FontFamily="{StaticResource Elite}" FontSize="38"
                           Foreground="{StaticResource CreamMutedBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Label x:Name="LeastTriesLbl" Content="{x:Static p:Resources.ProfilePage_LeastTries}"
                           FontFamily="{StaticResource Elite}" FontSize="38"
                           Foreground="{StaticResource CreamBrush}" />

                    <Label x:Name="PlayerLeastTriesLbl" Content="{Binding LeastTriesText}"
                           FontFamily="{StaticResource Elite}" FontSize="38"
                           Foreground="{StaticResource CreamMutedBrush}" Margin="14,0,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,0,0,44">

                <Viewbox Stretch="UniformToFill" MaxHeight="71">
                    <TextBox x:Name="ReportUsernameTxt" Style="{StaticResource LongMetalTextBox}"
                             FontFamily="{StaticResource Elite}" FontSize="40"
                             Width="600" Height="80" Padding="20,0"
                             Foreground="{StaticResource InkMutedBrush}"
                             Text="{x:Static p:Resources.ProfilePage_ReportPlayer}"
                             IsEnabled="False" />
                </Viewbox>

                <Button x:Name="ReportBtn" Style="{StaticResource MetalButtonReport}"
                        Width="71" Height="71" Padding="0" Margin="16,0,0,0"
                        IsEnabled="False" />
            </StackPanel>

            <Button x:Name="BackBtn" Grid.Row="3" Style="{StaticResource MetalButtonRed}"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource Elite}" FontSize="46"
                    Width="374" Height="124"
                    Content="{x:Static p:Resources.UI_Back}"
                    IsEnabled="False" />
        </Grid>
    </Grid>
</Page>
