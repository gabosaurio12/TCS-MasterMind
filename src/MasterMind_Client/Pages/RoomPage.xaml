<Page x:Class="MasterMind_Client.Pages.RoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MasterMind_Client.Pages"
      mc:Ignorable="d" 
      xmlns:p="clr-namespace:MasterMind_Client.Properties"
      xmlns:controls="clr-namespace:MasterMind_Client.Pages.PagesUserControls"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="{x:Static p:Resources.RoomsPage_Title}"
      Background="#585858">

    <Grid Width="1400">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="650" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" x:Name="RoomTitleLbl" Content="{x:Static p:Resources.RoomPage_Room}"
           FontFamily="{StaticResource Aladin}" FontSize="112" Foreground="White"
           HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <!-- Left column -->

            <Grid Grid.Column="0" Background="#313539">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="70" />
                </Grid.RowDefinitions>

                <Label x:Name="ChatLbl" Grid.Row="0" Foreground="White"
                       FontFamily="{StaticResource Aladin}" FontSize="64"
                       Content="{x:Static p:Resources.RoomPage_Chat}" HorizontalAlignment="Center"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Top">
                    <TextBlock x:Name="ChatTxt"  Background="#313539"
                             FontFamily="{StaticResource Aladin}" FontSize="24"
                             Foreground="White" Width="650" Margin="10" />
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" >
                    <TextBox x:Name="MessageTxt" Grid.Row="2" Style="{StaticResource RoundedDarkTextBox}"
                             VerticalAlignment="Bottom" Margin="20" FontSize="20"
                             Width="610"/>

                    <Button x:Name="SendBtn" Content=">" Style="{StaticResource RoundedGreenButton}"
                            Width="30" Height="30" FontFamily="{StaticResource Aladin}"
                            FontSize="26" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
            
            <!-- Right column -->

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Label x:Name="DeciphersLbl" Grid.Row="0" Foreground="White"
                       FontFamily="{StaticResource Aladin}" FontSize="64"
                       Content="{x:Static p:Resources.RoomPage_Deciphers}" HorizontalAlignment="Center"/>

                <controls:RoomPlayerUserControl x:Name="PlayerOneUserControl"
                                                Grid.Row="1" Height="160" Width="470" />
                <controls:RoomPlayerUserControl x:Name="PlayerTwoUserControl"
                                                Grid.Row="2" Height="160" Width="470" />
            </Grid>
        </Grid>

        


        <!-- Buttons -->

        <Grid Grid.Row="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" Margin="0,0,40,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Button x:Name="EscapeBtn" Grid.Column="0"
                Content="{x:Static p:Resources.UI_Escape}"
                Width="280" Height="100" Margin="0,0,50,0"
                Foreground="White" FontSize="64"
                FontFamily="{StaticResource Aladin}"
                Style="{StaticResource RoundedRedButton}"
                Click="EscapeBtn_Click" />

            <Button x:Name="ReadyBtn" Grid.Column="1"
                Content="{x:Static p:Resources.RoomPage_Ready}"
                Width="280" Height="100"
                Foreground="White" FontSize="64"
                FontFamily="{StaticResource Aladin}"
                Style="{StaticResource RoundedGreenButton}"
                Click="ReadyBtn_Click" />
            
            <Button x:Name="UnreadyBtn" Grid.Column="1"
                Content="{x:Static p:Resources.RoomPage_Unready}"
                Width="280" Height="100" Visibility="Hidden" IsEnabled="False"
                Foreground="White" FontSize="64"
                FontFamily="{StaticResource Aladin}"
                Style="{StaticResource RoundedButton}"
                Click="UnreadyBtn_Click" />
        </Grid>


    </Grid>
</Page>
