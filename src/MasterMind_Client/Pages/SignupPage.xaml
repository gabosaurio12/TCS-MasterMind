<Page x:Class="MasterMind_Client.Pages.SignupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MasterMind_Client.Pages"
      mc:Ignorable="d"     
      xmlns:p="clr-namespace:MasterMind_Client.Properties"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="{x:Static p:Resources.SignupPage_Title}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Backgrounds -->
        <Rectangle Grid.Column="0" Fill="{StaticResource BgLeftPanelBrush}" />
        <Rectangle Grid.Column="1" Fill="{StaticResource BgRightPanelBrush}" />

        <!-- Left panel: logo and machine -->
        <Grid Grid.Column="0" Margin="40,40,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Rectangle Grid.Row="0" Width="660" Height="248" HorizontalAlignment="Center"
                       Fill="{StaticResource LogoBrush}" />

            <Rectangle Grid.Row="1" Width="640" Height="674" HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,30,0,0"
                       Fill="{StaticResource MachineBrush}" />
        </Grid>

        <!-- Right panel: form -->
        <Grid Grid.Column="1" Margin="90,0,90,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="200" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Viewbox Grid.Row="0" Stretch="Fill" StretchDirection="DownOnly" MaxHeight="130">
                <Label x:Name="PageTitleLbl" Content="{x:Static p:Resources.SignupPage_Title}"
                       Style="{StaticResource MetalTitleLbl}"
                       FontFamily="{StaticResource Elite}" FontSize="104" />
            </Viewbox>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Label x:Name="UsernameLbl" Content="{x:Static p:Resources.Player_Username}"
                       Style="{StaticResource MetalFieldLbl}" FontFamily="{StaticResource Elite}"
                       FontSize="52"/>

                <TextBox x:Name="UsernameTxt" FontFamily="{StaticResource Elite}"
                         Width="600" Height="80" FontSize="40" Margin="0,6,0,26"
                         Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MetalTextBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUsernameEmpty}" Value="True">
                                    <Setter Property="Foreground" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Label x:Name="EmailLbl" Content="{x:Static p:Resources.Player_Email}"
                       Style="{StaticResource MetalFieldLbl}" FontFamily="{StaticResource Elite}"
                       FontSize="52"/>

                <TextBox x:Name="EmailTxt" FontFamily="{StaticResource Elite}"
                         Width="600" Height="80" FontSize="40" Margin="0,6,0,26"
                         Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MetalTextBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmailEmpty}" Value="True">
                                    <Setter Property="Foreground" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Label x:Name="PasswordLbl" Content="{x:Static p:Resources.Player_Password}"
                       FontFamily="{StaticResource Elite}" FontSize="52">
                    <Label.Style>
                        <Style TargetType="Label" BasedOn="{StaticResource MetalFieldLbl}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPasswordEmpty}" Value="True">
                                    <Setter Property="Foreground" Value="Red" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Label.Style>
                </Label>

                <PasswordBox x:Name="PasswordTxt" Style="{StaticResource MetalPasswordBox}"
                             FontFamily="{StaticResource Elite}"
                             Width="600" Height="80" FontSize="40" Margin="0,6,0,30"
                             PasswordChanged="PasswordTxt_PasswordChanged" />

                <Button x:Name="RegisterBtn" Style="{StaticResource MetalButtonGreen}"
                        FontFamily="{StaticResource Elite}" FontSize="38"
                        Width="280" Height="100"
                        Content="{x:Static p:Resources.SignupPage_Register}"
                        Command="{Binding RegisterCommand}" />

                <StackPanel HorizontalAlignment="Center" Margin="0,30,0,0">
                    <Label x:Name="AccountQuestionLbl" Content="{x:Static p:Resources.SignupPage_AccountQuestion}"
                           FontFamily="{StaticResource Elite}" FontSize="32"
                           Foreground="{StaticResource CreamBrush}"
                           HorizontalAlignment="Center" />

                    <TextBlock FontFamily="{StaticResource Elite}" FontSize="32" HorizontalAlignment="Center">
                        <Hyperlink x:Name="LoginLink" Click="LoginLink_Click" Foreground="{StaticResource LinkBrush}">
                            <Run Text="{x:Static p:Resources.SignupPage_LoginLink}" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Button x:Name="LanguageBtn" Grid.Column="1"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,50,40"
                Width="100" Height="80" Content="🌐"
                Style="{StaticResource MetalButtonBlue}"
                FontFamily="{StaticResource Elite}" FontSize="32"
                Command="{Binding LanguageCommand}" />
    </Grid>
</Page>