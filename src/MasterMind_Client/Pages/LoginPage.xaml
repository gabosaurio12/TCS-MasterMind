<Page x:Class="MasterMind_Client.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MasterMind_Client.Pages"
      mc:Ignorable="d" 
      xmlns:p="clr-namespace:MasterMind_Client.Properties"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="{x:Static p:Resources.LoginPage_Title}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Backgrounds -->
        <Rectangle Grid.Column="0" Fill="{StaticResource BgLeftPanelBrush}" />
        <Rectangle Grid.Column="1" Fill="{StaticResource BgRightPanelBrush}" />

        <!-- Left panel: logo and machine -->
        <Grid Grid.Column="0" Margin="40,40,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Rectangle Grid.Row="0" Width="660" Height="248" HorizontalAlignment="Center"
                       Fill="{StaticResource LogoBrush}" />

            <Rectangle Grid.Row="1" Width="640" Height="674" HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,30,0,0"
                       Fill="{StaticResource MachineBrush}" />
        </Grid>

        <!-- Right panel: form -->
        <Grid Grid.Column="1" Margin="90,0,90,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="230" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Viewbox Grid.Row="0" Stretch="Fill" StretchDirection="DownOnly" MaxHeight="150">
                <Label x:Name="PageTitleLbl" Content="{x:Static p:Resources.LoginPage_Title}"
                       Style="{StaticResource MetalTitleLbl}"
                       FontFamily="{StaticResource Elite}" FontSize="104" />
            </Viewbox>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Label x:Name="UsernameLbl" Content="{x:Static p:Resources.Player_Username}"
                       Style="{StaticResource MetalFieldLbl}" FontFamily="{StaticResource Elite}" />

                <TextBox x:Name="UsernameTxt" Style="{StaticResource MetalTextBox}"
                         FontFamily="{StaticResource Elite}"
                         Width="600" Height="80" FontSize="40" Margin="0,10,0,30"
                         Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Label x:Name="PasswordLbl" Content="{x:Static p:Resources.Player_Password}"
                       Style="{StaticResource MetalFieldLbl}" FontFamily="{StaticResource Elite}" />

                <PasswordBox x:Name="PasswordTxt" Style="{StaticResource MetalPasswordBox}"
                             FontFamily="{StaticResource Elite}"
                             Width="600" Height="80" FontSize="40" Margin="0,10,0,0"
                             PasswordChanged="PasswordTxt_PasswordChanged" />

                <CheckBox x:Name="RememberLoginCheck" Style="{StaticResource MetalCheckBox}"
                          Content="{x:Static p:Resources.LoginPage_RememberLogin}"
                          FontFamily="{StaticResource Elite}" FontSize="38"
                          Margin="0,40,0,0" HorizontalAlignment="Center"
                          IsChecked="{Binding RememberLogin, Mode=TwoWay}" />

                <Button x:Name="LoginBtn" Style="{StaticResource MetalButtonGreen}"
                        FontFamily="{StaticResource Elite}" FontSize="38"
                        Width="200" Height="100" Margin="0,40,0,0"
                        Content="{x:Static p:Resources.LoginPage_Login}"
                        Command="{Binding LoginCommand}" />

                <StackPanel HorizontalAlignment="Center" Margin="0,36,0,0">
                    <Label x:Name="AccountQuestionLbl" Content="{x:Static p:Resources.LoginPage_AccountQuestion}"
                           FontFamily="{StaticResource Elite}" FontSize="38"
                           Foreground="{StaticResource CreamBrush}"
                           HorizontalAlignment="Center" />

                    <TextBlock FontFamily="{StaticResource Elite}" FontSize="40" HorizontalAlignment="Center">
                        <Hyperlink x:Name="SignupLink" Click="SignupLink_Click" Foreground="{StaticResource LinkBrush}">
                            <Run Text="{x:Static p:Resources.LoginPage_SignupLink}" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Button x:Name="LanguageBtn" Grid.Column="1"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,50,40"
                Width="100" Height="80" Content="🌐"
                Style="{StaticResource MetalButtonBlue}"
                FontFamily="{StaticResource Elite}" FontSize="32"
                Command="{Binding LanguageCommand}" />
    </Grid>
</Page>