<UserControl x:Class="MasterMind_Client.Pages.PagesUserControls.RoomPlayerUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MasterMind_Client.Pages.PagesUserControls"
             mc:Ignorable="d"
             d:DesignHeight="215" d:DesignWidth="650">

    <Grid>
        <Image x:Name="CardImg" Style="{StaticResource RoomPlayerCardImage}" />

        <Ellipse x:Name="AvatarEllipse" Width="132" Height="132"
                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="76,0,0,0">
            <Ellipse.Fill>
                <ImageBrush ImageSource="{StaticResource AvatarImage}" Stretch="UniformToFill" />
            </Ellipse.Fill>
        </Ellipse>

        <Viewbox StretchDirection="DownOnly" MaxHeight="64"
                 HorizontalAlignment="Center" Margin="230,0,130,0">
            <TextBlock x:Name="UsernameTxt" FontFamily="{StaticResource Elite}" FontSize="56"
                       Foreground="{StaticResource CreamBrush}" Text="{Binding Username}" />
        </Viewbox>
    </Grid>
</UserControl>
