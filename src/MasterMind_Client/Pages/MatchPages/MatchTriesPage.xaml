<Page x:Class="MasterMind_Client.Pages.MatchPages.MatchTriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MasterMind_Client.Pages.MatchPages"
      xmlns:p="clr-namespace:MasterMind_Client.Properties"
      xmlns:helpers="clr-namespace:MasterMind_Client.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="MatchTriesPage" Background="{DynamicResource BgMatchBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:PinColourToImageConverter x:Key="PinColourToImage" />
        <helpers:ClueKindToImageConverter x:Key="ClueKindToImage" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <!-- Left panel: Remaining tries -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
            <Border Background="{DynamicResource BgLeftPanelGreenBrush}" CornerRadius="15" Padding="20" Width="360" Height="220" BorderBrush="{StaticResource InkBrush}" BorderThickness="4">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label x:Name="RemainingTriesLbl" Content="{x:Static p:Resources.MatchTries_RemainingTries}" FontFamily="{StaticResource Elite}" FontSize="36" Foreground="{DynamicResource CreamBrush}" HorizontalAlignment="Center"/>
                    <Grid Width="160" Height="90" Margin="0,15,0,0">
                        <Image Source="{DynamicResource CounterImage}" Stretch="Fill"/>
                        <TextBlock x:Name="RemainingTriesTxt" Text="{Binding RemainingTries}" FontFamily="{StaticResource Elite}" FontSize="48" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Center: Deciphering Machine & Board -->
        <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="950" Height="900">
            <!-- Machine Body Without OK Button -->
            <Image Source="{DynamicResource DecipheringMachineWithoutOkImage}" Stretch="Fill" Margin="0,-39,0,-62"/>

            <!-- OK Button (Interactive) -->
            <Button x:Name="TryBtn" Command="{Binding TryCommand}" Width="120" Height="120" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,66,147,0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Image Source="{DynamicResource OkButtonImage}" Stretch="Fill" Margin="0,0,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Tries Rows Container -->
            <ItemsControl ItemsSource="{Binding TriesRows}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="45,150,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="95" Width="720" Margin="0,7,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Clue Pins (4 slots) -->
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding ClueSlots}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="45" Height="45" Margin="5" Background="Transparent">
                                            <Image Source="{Binding Kind, Converter={StaticResource ClueKindToImage}}" Stretch="Uniform"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Colour Pins (4 large round slots) -->
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding PinSlots}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding PlacePinCommand}" Width="70" Height="70" Margin="5" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Image Source="{DynamicResource ColourPinEmptyImage}" Stretch="Uniform"/>
                                                        <Image Source="{Binding Colour, Converter={StaticResource PinColourToImage}}" Stretch="Uniform" Margin="4"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>


        <!-- Right panel: Pin Colours -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
            <Border Background="{DynamicResource BgLeftPanelGreenBrush}" CornerRadius="15" Padding="15" Width="280" Height="780" BorderBrush="{StaticResource InkBrush}" BorderThickness="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Static p:Resources.MatchTries_PinColours}" FontFamily="{StaticResource Elite}" FontSize="28" Foreground="{DynamicResource CreamBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <ItemsControl x:Name="PinColoursList" Grid.Row="1" ItemsSource="{Binding PaletteColours}" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectColourCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}" Width="95" Height="95" Margin="0,10" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Image Source="{Binding Colour, Converter={StaticResource PinColourToImage}}" Stretch="Uniform"/>
                                                <Border BorderBrush="{StaticResource MetalBrush}" BorderThickness="4" CornerRadius="50" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>