<Page x:Class="MasterMind_Client.Pages.MatchPages.TriesMatchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MasterMind_Client.Pages.MatchPages"
      xmlns:p="clr-namespace:MasterMind_Client.Properties"
      mc:Ignorable="d" 
      xmlns:controls="clr-namespace:MasterMind_Client.Pages.MatchPages.UserControls"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="TriesMatchPage" Background="#585858">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label x:Name="RemainingTriesLbl"
                   FontFamily="{StaticResource Aladin}" FontSize="72"
                   Foreground="White" Content="Remaining Tries"
                   HorizontalAlignment="Center" />

            <Label x:Name="RemainingTriesCounterLbl"
                   FontFamily="{StaticResource Aladin}" FontSize="72"
                   Foreground="White" Content="12"
                   HorizontalAlignment="Center" />
        </StackPanel>

        <controls:BoardUserControl x:Name="BoardUC" Grid.Column="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Width="645" Height="745" />

        <StackPanel Grid.Column="2" Orientation="Vertical"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label x:Name="PinsLbl"
                   FontFamily="{StaticResource Aladin}" FontSize="72"
                   Foreground="White" Content="Pins"
                   HorizontalAlignment="Center" />

            <controls:PinsUserControl />
        </StackPanel>
    </Grid>
</Page>
