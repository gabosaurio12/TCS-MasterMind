<UserControl x:Class="MasterMind_Client.Pages.MatchPages.UserControls.PinsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MasterMind_Client.Pages.MatchPages.UserControls"
             mc:Ignorable="d" 
             Height="575" Width="170">
    <Border CornerRadius="10" Background="#202020">
        <Grid>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <Button x:Name="BluePin" Width="80" Height="80" Style="{StaticResource PinButtonBlue}" />
                <Button x:Name="RedPin" Width="80" Height="80" Style="{StaticResource PinButtonRed}" />
                <Button x:Name="YellowPin" Width="80" Height="80" Style="{StaticResource PinButtonYellow}" />
                <Button x:Name="GreenPin" Width="80" Height="80" Style="{StaticResource PinButtonGreen}" />
                <Button x:Name="WhitePin" Width="80" Height="80" Style="{StaticResource PinButtonWhite}" />
                <Button x:Name="OrangePin" Width="80" Height="80" Style="{StaticResource PinButtonOrange}" />
            </StackPanel>

        </Grid>
    </Border>
    
</UserControl>
