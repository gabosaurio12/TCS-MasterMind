<UserControl x:Class="MasterMind_Client.Pages.MatchPages.UserControls.CodeTryUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MasterMind_Client.Pages.MatchPages.UserControls"
             mc:Ignorable="d" 
             Height="80" Width="535">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="CluesStackPanel" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">

            <Border CornerRadius="10" Background="#141414" Width="45" Height="45"
                    BorderBrush="#ABBCC3" BorderThickness="3">
                <Rectangle Width="45" Height="45" />
            </Border>

            <Border CornerRadius="10" Background="#141414" Width="45" Height="45"
                    BorderBrush="#ABBCC3" BorderThickness="3">
                <Rectangle Width="45" Height="45" />
            </Border>

            <Border CornerRadius="10" Background="#141414" Width="45" Height="45"
                    BorderBrush="#ABBCC3" BorderThickness="3">
                <Rectangle Width="45" Height="45" />
            </Border>

            <Border CornerRadius="10" Background="#141414" Width="45" Height="45"
                    BorderBrush="#ABBCC3" BorderThickness="3">
                <Rectangle Width="45" Height="45" />
            </Border>
        </StackPanel>

        <StackPanel x:Name="ColorsStackPanel" Grid.Column="1" Orientation="Horizontal">

            <Border Background="#141414" Width="80" Height="80" BorderThickness="4"
                    BorderBrush="#ABBCC3" CornerRadius="80" />

            <Border Background="#141414" Width="80" Height="80" BorderThickness="4"
                    BorderBrush="#ABBCC3" CornerRadius="80" />

            <Border Background="#141414" Width="80" Height="80" BorderThickness="4"
                    BorderBrush="#ABBCC3" CornerRadius="80" />

            <Border Background="#141414" Width="80" Height="80" BorderThickness="4"
                    BorderBrush="#ABBCC3" CornerRadius="80" />
            
        </StackPanel>
            
    </Grid>
</UserControl>
