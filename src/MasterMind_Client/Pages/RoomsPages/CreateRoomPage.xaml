<Page x:Class="MasterMind_Client.Pages.RoomsPages.CreateRoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MasterMind_Client.Pages.RoomsPages"
      xmlns:p="clr-namespace:MasterMind_Client.Properties"
      xmlns:controls="clr-namespace:MasterMind_Client.Controls"
      mc:Ignorable="d"  
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="{x:Static p:Resources.CreateRoomPage_Title}"
      Background="{StaticResource BgRoomsBrush}">

    <Grid>
        <!-- Title -->

        <Viewbox VerticalAlignment="Top" Stretch="Uniform" StretchDirection="DownOnly"
                 MaxHeight="120" Margin="0,36,0,0">
            <Label x:Name="PageTitleLbl" Content="{x:Static p:Resources.CreateRoomPage_Title}"
                   Style="{StaticResource MetalTitleLbl}"
                   FontFamily="{StaticResource Elite}" FontSize="104" />
        </Viewbox>

        <!-- Container Panel -->

        <Grid Width="1420" Height="646" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
            <controls:NineSlice Source="{StaticResource RoomsContainerImage}" SliceRatio="0.04,0.06,0.04,0.06" />

            <Grid Margin="70,50,70,50">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Room Name Section -->

                <StackPanel Grid.Row="0" Margin="0,0,0,30">
                    <Label x:Name="RoomNameLbl"
                           Content="{x:Static p:Resources.CreateRoomPage_Name}"
                           Style="{StaticResource MetalFieldLbl}"
                           FontFamily="{StaticResource Elite}" FontSize="44"
                           Margin="0,0,0,10" />

                    <TextBox x:Name="RoomNameTxt"
                             Style="{StaticResource LongMetalTextBox}"
                             Height="70" FontSize="36"
                             FontFamily="{StaticResource Elite}"
                             Text="{Binding RoomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- Options Grid -->

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Gamemode & Privacy -->

                    <StackPanel Grid.Column="0" Margin="0,0,40,0">
                        <!-- Gamemode Stack -->
                        <StackPanel Margin="0,0,0,30">
                            <Label x:Name="GamemodeLbl"
                                   Content="{x:Static p:Resources.CreateRoomPage_Mode}"
                                   Style="{StaticResource MetalFieldLbl}"
                                   FontFamily="{StaticResource Elite}" FontSize="40"
                                   Margin="0,0,0,10" />

                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TimeTrialBtn" Content="{x:Static p:Resources.Gamemode_TimeTrial}"
                                             GroupName="GamemodeGroup"
                                             Style="{StaticResource RadioButtonBlue}" FontFamily="{StaticResource Elite}"
                                             Width="240" Height="60" FontSize="32"
                                             Margin="0,0,30,0" IsChecked="{Binding IsTimeTrial, Mode=TwoWay}"/>

                                <RadioButton x:Name="TriesBtn" Content="{x:Static p:Resources.Gamemode_Tries}"
                                             GroupName="GamemodeGroup"
                                             Style="{StaticResource RadioButtonBlue}" FontFamily="{StaticResource Elite}"
                                             Width="240" Height="60" FontSize="32"
                                             IsChecked="{Binding IsTries, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Privacy Stack -->
                        <StackPanel>
                            <Label x:Name="PrivacyLbl"
                                   Content="{x:Static p:Resources.CreateRoomPage_Privacy}"
                                   Style="{StaticResource MetalFieldLbl}"
                                   FontFamily="{StaticResource Elite}" FontSize="40"
                                   Margin="0,0,0,10" />

                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PrivateBtn" Content="{x:Static p:Resources.RoomPrivacy_Private}"
                                             GroupName="PrivacyGroup"
                                             Style="{StaticResource RadioButtonRed}" FontFamily="{StaticResource Elite}"
                                             Width="240" Height="60" FontSize="32"
                                             Margin="0,0,30,0" IsChecked="{Binding IsPrivate, Mode=TwoWay}"/>

                                <RadioButton x:Name="PublicBtn" Content="{x:Static p:Resources.RoomPrivacy_Public}"
                                             GroupName="PrivacyGroup"
                                             Style="{StaticResource RadioButtonBlue}" FontFamily="{StaticResource Elite}"
                                             Width="240" Height="60" FontSize="32"
                                             IsChecked="{Binding IsPublic, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right Column: Difficulty -->

                    <StackPanel Grid.Column="1">
                        <Label x:Name="DifficultyLbl"
                               Content="{x:Static p:Resources.CreateRoomPage_Difficulty}"
                               Style="{StaticResource MetalFieldLbl}"
                               FontFamily="{StaticResource Elite}" FontSize="40"
                               Margin="0,0,0,10" />

                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <RadioButton x:Name="EasyBtn" Content="{x:Static p:Resources.GameDifficulty_Easy}"
                                             GroupName="DifficultyGroup"
                                             Style="{StaticResource RadioButtonBlue}" FontFamily="{StaticResource Elite}"
                                             Width="170" Height="60" FontSize="30"
                                             Margin="0,0,20,0" IsChecked="{Binding IsEasy, Mode=TwoWay}"/>

                                <RadioButton x:Name="NormalBtn" Content="{x:Static p:Resources.GameDifficulty_Normal}"
                                             GroupName="DifficultyGroup"
                                             Style="{StaticResource RadioButtonYellow}" FontFamily="{StaticResource Elite}"
                                             Width="170" Height="60" FontSize="30"
                                             Margin="0,0,20,0" IsChecked="{Binding IsNormal, Mode=TwoWay}"/>

                                <RadioButton x:Name="HardBtn" Content="{x:Static p:Resources.GameDifficulty_Hard}"
                                             GroupName="DifficultyGroup"
                                             Style="{StaticResource RadioButtonOrange}" FontFamily="{StaticResource Elite}"
                                             Width="170" Height="60" FontSize="30"
                                             IsChecked="{Binding IsHard, Mode=TwoWay}"/>
                            </StackPanel>

                            <RadioButton x:Name="EnigmaBtn" Content="{x:Static p:Resources.GameDifficulty_Enigma}"
                                         GroupName="DifficultyGroup"
                                         Style="{StaticResource RadioButtonRed}" FontFamily="{StaticResource Elite}"
                                         Width="170" Height="60" FontSize="30"
                                         HorizontalAlignment="Left"
                                         IsChecked="{Binding IsEnigma, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom Action Buttons -->

        <Button x:Name="CancelBtn" Content="{x:Static p:Resources.UI_Cancel}"
                Style="{StaticResource MediumMetalButtonRed}"
                Width="380" Height="110" Margin="80,0,0,80"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                FontFamily="{StaticResource Elite}" FontSize="44"
                Command="{Binding CancelCommand}" />

        <Button x:Name="CreateBtn" Content="{x:Static p:Resources.UI_Create}"
                Style="{StaticResource MediumMetalButtonGreen}"
                Width="380" Height="110" Margin="0,0,80,80"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                FontFamily="{StaticResource Elite}" FontSize="44"
                Command="{Binding CreateCommand}" />

    </Grid>
</Page>
