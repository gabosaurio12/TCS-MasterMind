<Page x:Class="MasterMind_Client.Pages.RoomsPages.CreateRoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MasterMind_Client.Pages.RoomsPages"
      xmlns:p="clr-namespace:MasterMind_Client.Properties"
      mc:Ignorable="d"  
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="{x:Static p:Resources.CreateRoomPage_Title}"
      Background="#585858">
    

    
    
    <Grid Width="1500">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="650" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" x:Name="PageTitleLbl" Content="{x:Static p:Resources.CreateRoomPage_Title}"
               FontFamily="{StaticResource Aladin}" FontSize="112" Foreground="White"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Form Grid -->
            <Grid Grid.Row="1" Background="#313539">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="400" />
                </Grid.RowDefinitions>

                <!-- Form Grid Row 0 -->
                <StackPanel Grid.Row="0">
                    <Label x:Name="RoomNameLbl"
                       Content="{x:Static p:Resources.CreateRoomPage_Name}"
                       FontFamily="{StaticResource Aladin}" Foreground="White"
                       FontSize="64" Margin="66,15,0,15"/>

                    <TextBox x:Name="RoomNameTxt"
                         Width="1400" Height="94" Foreground="White"
                         FontFamily="{StaticResource Aladin}"
                         FontSize="78"
                         Style="{StaticResource RoundedDarkTextBox}" />
                </StackPanel>

                <!-- ButtonsGrid -->

                <Grid Grid.Row="1" Margin="55,0,55,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ButtonsGrid Column0-->

                    <StackPanel Grid.Column="0">

                        <!-- Gamemode Stack -->
                        <StackPanel HorizontalAlignment="Left">
                            <Label x:Name="GamemodeLbl"
                               Content="{x:Static p:Resources.CreateRoomPage_Mode}"
                               FontFamily="{StaticResource Aladin}" Foreground="White"
                               FontSize="64" Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TimeTrialBtn" Content="{x:Static p:Resources.Gamemode_TimeTrial}"
                                         GroupName="GamemodeGroup"
                                         Style="{StaticResource RadioButtonBlue}" FontFamily="{StaticResource Aladin}"
                                         Width="250" Height="64" FontSize="48"
                                         Margin="0,0,40,0"/>

                                <RadioButton x:Name="TriesBtn" Content="{x:Static p:Resources.Gamemode_Tries}"
                                         GroupName="GamemodeGroup"
                                         Style="{StaticResource RadioButtonBlue}" FontFamily="{StaticResource Aladin}"
                                         Width="250" Height="64" FontSize="48"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- PrivacyStack -->
                        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Left">
                            <Label x:Name="PrivacyLbl"
                               Content="{x:Static p:Resources.CreateRoomPage_Privacy}"
                               FontFamily="{StaticResource Aladin}" Foreground="White"
                               FontSize="64" Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PrivateBtn" Content="{x:Static p:Resources.RoomPrivacy_Private}"
                                         GroupName="PrivacyGroup"
                                         Style="{StaticResource RadioButtonRed}" FontFamily="{StaticResource Aladin}"
                                         Width="250" Height="64" FontSize="48"
                                         Margin="0,0,40,0"/>

                                <RadioButton x:Name="PublicBtn" Content="{x:Static p:Resources.RoomPrivacy_Public}"
                                         GroupName="PrivacyGroup"
                                         Style="{StaticResource RadioButtonBlue}" FontFamily="{StaticResource Aladin}"
                                         Width="250" Height="64" FontSize="48"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- ButtonsGrid Column1 -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <Label x:Name="DifficultyLbl"
                           Content="{x:Static p:Resources.CreateRoomPage_Difficulty}"
                           FontFamily="{StaticResource Aladin}" Foreground="White"
                           FontSize="64" Margin="0,0,0,15"/>

                        <!-- DifficultyStack -->
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="EasyBtn" Content="{x:Static p:Resources.GameDifficulty_Easy}"
                                         GroupName="DifficultyGroup"
                                         Style="{StaticResource RadioButtonBlue}" FontFamily="{StaticResource Aladin}"
                                         Width="200" Height="64" FontSize="48"
                                         Margin="0,0,40,0"/>

                                <RadioButton x:Name="NormalBtn" Content="{x:Static p:Resources.GameDifficulty_Normal}"
                                         GroupName="DifficultyGroup"
                                         Style="{StaticResource RadioButtonYellow}" FontFamily="{StaticResource Aladin}"
                                         Width="200" Height="64" FontSize="48"
                                         Margin="0,0,40,0"/>

                                <RadioButton x:Name="HardBtn" Content="{x:Static p:Resources.GameDifficulty_Hard}"
                                         GroupName="DifficultyGroup"
                                         Style="{StaticResource RadioButtonOrange}" FontFamily="{StaticResource Aladin}"
                                         Width="200" Height="64" FontSize="48"/>
                            </StackPanel>

                            <RadioButton x:Name="EnigmaBtn" Content="{x:Static p:Resources.GameDifficulty_Enigma}"
                                     GroupName="DifficultyGroup"
                                     Style="{StaticResource RadioButtonRed}" FontFamily="{StaticResource Aladin}"
                                     Width="200" Height="64" FontSize="48"
                                     Margin="0,40,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Buttons -->

            <Button x:Name="CancelBtn" Grid.Row="2"
                HorizontalAlignment="Left"
                Content="{x:Static p:Resources.UI_Cancel}"
                Width="280" Height="100"
                Foreground="White" FontSize="64"
                FontFamily="{StaticResource Aladin}"
                Style="{StaticResource RoundedRedButton}"
                Click="CancelBtn_Click" />

            <Button x:Name="CreateBtn" Grid.Row="2"
                HorizontalAlignment="Right"
                Content="{x:Static p:Resources.UI_Create}"
                Width="280" Height="100"
                Foreground="White" FontSize="64"
                FontFamily="{StaticResource Aladin}"
                Style="{StaticResource RoundedGreenButton}"
                Click="CreateBtn_Click" />
        </Grid>

    </Page>
