<Page x:Class="MasterMind_Client.Pages.RoomsPages.RoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:MasterMind_Client.Pages.RoomsPages"
      mc:Ignorable="d"
      xmlns:p="clr-namespace:MasterMind_Client.Properties"
      xmlns:userControls="clr-namespace:MasterMind_Client.Pages.PagesUserControls"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="{x:Static p:Resources.RoomsPage_Title}"
      Background="{StaticResource BgRoomsBrush}">

    <Grid>
        <!-- Title -->

        <Viewbox VerticalAlignment="Top" Stretch="Uniform" StretchDirection="DownOnly"
                 MaxHeight="120" Margin="0,36,0,0">
            <Label x:Name="RoomTitleLbl" Content="{Binding RoomTitle}"
                   Style="{StaticResource MetalTitleLbl}"
                   FontFamily="{StaticResource Elite}" FontSize="104" />
        </Viewbox>

        <!-- Chat panel -->

        <Grid Width="800" Height="600" HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="150,190,0,0">
            <Image x:Name="ChatPanelImg" Source="{StaticResource ChatPanelImage}" />

            <Label x:Name="ChatLbl" Content="{x:Static p:Resources.RoomPage_Chat}"
                   Style="{StaticResource MetalFieldLbl}"
                   FontFamily="{StaticResource Elite}" FontSize="44"
                   VerticalAlignment="Top" Height="74" Margin="0,44,0,0" />

            <ScrollViewer x:Name="ChatScroll" Margin="54,134,54,180"
                          VerticalScrollBarVisibility="Disabled" VerticalAlignment="Stretch">
                <TextBlock x:Name="ChatTxt" TextWrapping="Wrap"
                           Text="{Binding ChatText, NotifyOnTargetUpdated=True}"
                           FontFamily="{StaticResource Elite}" FontSize="26"
                           Foreground="{StaticResource CreamBrush}" />
            </ScrollViewer>

            <TextBox x:Name="MessageTxt" Style="{StaticResource MetalChatTextBox}"
                     VerticalAlignment="Top" Height="40"
                     Margin="120,518,230,0" FontSize="26"
                     MaxLength="200"
                     Text="{Binding MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource Elite}" />

            <Button x:Name="SendBtn" Style="{StaticResource MetalSendButton}"
                    Width="45" Height="45"
                    Command="{Binding SendCommand}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="640,515,0,0" />
        </Grid>

        <!-- Deciphers -->

        <Viewbox HorizontalAlignment="Right" VerticalAlignment="Top" Stretch="Uniform"
                 StretchDirection="DownOnly" MaxHeight="72" Margin="0,230,330,0">
            <Label x:Name="DeciphersLbl" Content="{x:Static p:Resources.RoomPage_Deciphers}"
                   Style="{StaticResource MetalFieldLbl}"
                   FontFamily="{StaticResource Elite}" FontSize="56" />
        </Viewbox>

        <userControls:RoomPlayerUserControl x:Name="PlayerOneUserControl"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Width="650" Height="215" Margin="0,340,200,0"
                                            DataContext="{Binding PlayerOne}" />
        <userControls:RoomPlayerUserControl x:Name="PlayerTwoUserControl"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Width="650" Height="215" Margin="0,600,200,0"
                                            DataContext="{Binding PlayerTwo}" />

        <!-- Room code -->

        <Grid Width="500" Height="280" HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Margin="300,0,0,10">
            <Image x:Name="RoomCodeImg" Source="{StaticResource RoomCodeImage}" />

            <Label x:Name="RoomCodeTitleLbl" Content="{x:Static p:Resources.RoomPage_RoomCode}"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Width="196" Height="53" Margin="0,24,0,0"
                   FontFamily="{StaticResource Elite}" FontSize="22"
                   Foreground="{StaticResource InkBrush}"
                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

            <Label x:Name="RoomCodeValueLbl" Content="{Binding RoomCode}"
                   Margin="30,84,30,56"
                   FontFamily="{StaticResource Elite}" FontSize="72"
                   Foreground="{StaticResource InkBrush}"
                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>

        <!-- Buttons -->

        <Button x:Name="EscapeBtn" Content="{x:Static p:Resources.UI_Escape}"
                Style="{StaticResource MediumMetalButtonRed}"
                Width="380" Height="110" Margin="0,0,500,80"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                FontFamily="{StaticResource Elite}" FontSize="44"
                Command="{Binding EscapeCommand}" />

        <Button x:Name="ReadyBtn" Content="{x:Static p:Resources.RoomPage_Ready}"
                Width="380" Height="110" Margin="0,0,80,80"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                FontFamily="{StaticResource Elite}" FontSize="44"
                Command="{Binding ReadyCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource MediumMetalButtonGreen}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Button x:Name="UnreadyBtn" Content="{x:Static p:Resources.RoomPage_Unready}"
                Width="380" Height="110" Margin="0,0,80,80"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                FontFamily="{StaticResource Elite}" FontSize="44"
                Command="{Binding UnreadyCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource MediumMetalButtonGreen}">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Setter Property="IsEnabled" Value="False" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="IsEnabled" Value="True" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

    </Grid>
</Page>
