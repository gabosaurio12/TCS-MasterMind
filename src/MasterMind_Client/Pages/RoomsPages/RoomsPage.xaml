<Page x:Class="MasterMind_Client.Pages.RoomsPages.RoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:MasterMind_Client.Controls"
      xmlns:userControls="clr-namespace:MasterMind_Client.Pages.PagesUserControls"
      mc:Ignorable="d"
      xmlns:p="clr-namespace:MasterMind_Client.Properties"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="{x:Static p:Resources.RoomsPage_Title}"
      Background="{StaticResource BgRoomsBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="184" />
            <RowDefinition Height="646" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="112"
                 VerticalAlignment="Bottom" Margin="0,0,0,46">
            <Label x:Name="PageTitleLbl" Content="{x:Static p:Resources.RoomsPage_Title}"
                   Style="{StaticResource MetalTitleLbl}"
                   FontFamily="{StaticResource Elite}" FontSize="104" />
        </Viewbox>

        <Grid Grid.Row="1" Width="1420" Height="646" HorizontalAlignment="Center">
            <controls:NineSlice Source="{StaticResource RoomsContainerImage}"
                                SliceRatio="0.04,0.06,0.04,0.06" />

            <ListBox x:Name="RoomsList" ItemsSource="{Binding Rooms}"
                     SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                     Margin="42,34" Padding="0" Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Center"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <userControls:MatchRoomUserControl Margin="0,0,0,22" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="BackBtn" Content="{x:Static p:Resources.UI_Back}"
                    Style="{StaticResource MetalButtonRed}"
                    Width="288" Height="140" Margin="0,0,32,0"
                    FontFamily="{StaticResource Elite}" FontSize="52"
                    Command="{Binding BackCommand}" />

            <Button x:Name="JoinBtn" Content="{x:Static p:Resources.RoomsPage_Join}"
                    Style="{StaticResource MetalButtonBlue}"
                    Width="288" Height="140" Margin="0,0,32,0"
                    FontFamily="{StaticResource Elite}" FontSize="52"
                    Command="{Binding JoinCommand}" />

            <Button x:Name="CodeBtn" Content="{x:Static p:Resources.RoomsPage_Code}"
                    Style="{StaticResource MetalButtonBlue}"
                    Width="288" Height="140" Margin="0,0,32,0"
                    FontFamily="{StaticResource Elite}" FontSize="52"
                    Command="{Binding CodeCommand}" />

            <Button x:Name="CreateBtn" Content="{x:Static p:Resources.UI_Create}"
                    Style="{StaticResource MetalButtonGreen}"
                    Width="288" Height="140"
                    FontFamily="{StaticResource Elite}" FontSize="52"
                    Command="{Binding CreateCommand}" />
        </StackPanel>
    </Grid>
</Page>
