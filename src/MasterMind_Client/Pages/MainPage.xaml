<Page x:Class="MasterMind_Client.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MasterMind_Client.Pages"
      mc:Ignorable="d" 
      xmlns:p="clr-namespace:MasterMind_Client.Properties"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="{x:Static p:Resources.MainPage_Title}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="286" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Backgrounds -->
        <Rectangle Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Fill="#141414" />
        <Rectangle Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Fill="#585858" />

        <!-- Images -->
        <Image Grid.Column="0" Grid.Row="0" Source="/Images/MasterMindLogo.png"
       Width="625" Height="205"/>
        <Image Grid.Column="0" Grid.Row="1" Source="/Images/DecodingMachine.png"
       Width="533" Height="615"/>

        <!-- Column 2 -->

        <Label x:Name="PageTitleLbl" Content="{x:Static p:Resources.MainPage_Title}"
       Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center"
       VerticalAlignment="Center" Foreground="White" FontFamily="{StaticResource Aladin}"
       FontSize="128"/>

        <UniformGrid Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center"
             VerticalAlignment="Center" Rows="4" Columns="1" Margin="0,0,0,0">

            <Button x:Name="PlayBtn" Style="{StaticResource RoundedGreenButton}" Margin="20"
                    Width="345" Height="85" FontSize="64" 
                    Foreground="White" FontFamily="Aladin"
                    Content="{x:Static p:Resources.MainPage_Play}"
                    Click="PlayBtn_Click"/>

            <Button x:Name="ProfileBtn" Style="{StaticResource RoundedButton}"
                    Width="345" Height="85" FontSize="64" 
                    Foreground="White" FontFamily="Aladin"
                    Content="{x:Static p:Resources.MainPage_Profile}"
                    Click="ProfileBtn_Click" />

            <Button x:Name="FriendsBtn" Style="{StaticResource RoundedButton}"
                    Width="345" Height="85" FontSize="64" 
                    Foreground="White" FontFamily="Aladin"
                    Content="{x:Static p:Resources.MainPage_Friends}"
                    Click="FriendsBtn_Click" />

            <Button x:Name="ExitBtn" Style="{StaticResource RoundedRedButton}"
                    Width="345" Height="85" FontSize="64" 
                    Foreground="White" FontFamily="Aladin"
                    Content="{x:Static p:Resources.MainPage_Quit}"
                    Click="ExitBtn_Click" />

        </UniformGrid>

        <Button x:Name="LanguageBtn" Grid.Column="1" Grid.Row="1"
            Width="113" Height="85" Content="🌐"
            Foreground="White" Style="{StaticResource RoundedButton}"
            FontSize="60" FontFamily="{StaticResource Aladin}" Margin="792,666,55,43"
            Click="LanguageBtn_Click" />

    </Grid>
</Page>
