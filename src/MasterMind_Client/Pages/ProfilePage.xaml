<Page x:Class="MasterMind_Client.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MasterMind_Client.Pages"
      mc:Ignorable="d" 
      xmlns:p="clr-namespace:MasterMind_Client.Properties"
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="{x:Static p:Resources.MainPage_Profile}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Backgrounds -->
        <Rectangle Grid.Column="0" Fill="{StaticResource BgLeftPanelGreenBrush}" />
        <Rectangle Grid.Column="1" Fill="{StaticResource BgRightPanelBrush}" />

        <!-- Left panel: avatar, player data and update button -->
        <Grid Grid.Column="0" Margin="40,50,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Ellipse x:Name="Avatar" Grid.Row="0" Width="292" Height="292"
                     HorizontalAlignment="Center" Margin="0,10,0,20"
                     Stroke="{StaticResource FrameMetalBrush}" StrokeThickness="12">
                <Ellipse.Fill>
                    <ImageBrush x:Name="AvatarImg" ImageSource="{StaticResource AvatarImage}" Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Label x:Name="UsernameLbl" Content="{x:Static p:Resources.Player_Username}"
                       Style="{StaticResource MetalFieldLbl}"
                       FontFamily="{StaticResource Elite}" FontSize="68" />

                <Label x:Name="PlayerUsernameLbl" Content="{Binding Username}"
                       FontFamily="{StaticResource Elite}" FontSize="52"
                       Foreground="{StaticResource CreamMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,10,0,0" />

                <Label x:Name="EmailLbl" Content="{x:Static p:Resources.Player_Email}"
                       Style="{StaticResource MetalFieldLbl}"
                       FontFamily="{StaticResource Elite}" FontSize="68" Margin="0,34,0,0" />

                <Label x:Name="PlayerEmailLbl" Content="{Binding Email}"
                       FontFamily="{StaticResource Elite}" FontSize="52"
                       Foreground="{StaticResource CreamMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Button x:Name="UpdateBtn" Style="{StaticResource MetalButtonBlue}"
                        FontFamily="{StaticResource Elite}" FontSize="56"
                        Width="356" Height="115"
                        Content="{x:Static p:Resources.ProfilePage_Update}"
                        Command="{Binding UpdateCommand}" />

                <TextBlock HorizontalAlignment="Center" Margin="0,22,0,0"
                           FontFamily="{StaticResource Elite}" FontSize="36">
                    <Hyperlink x:Name="ChangePasswordLink" Foreground="{StaticResource LinkBrush}"
                               Click="ChangePasswordLink_Click">
                        <Run Text="{x:Static p:Resources.ProfilePage_ChangePassword}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Right panel: records, report field and back button -->
        <Grid Grid.Column="1" Margin="60,50,60,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="200" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Viewbox Grid.Row="0" Stretch="Fill" StretchDirection="DownOnly" MaxHeight="150">
                <Label x:Name="RecordsLbl" Content="{x:Static p:Resources.ProfilePage_Records}"
                       Style="{StaticResource MetalTitleLbl}"
                       FontFamily="{StaticResource Elite}" FontSize="140" />
            </Viewbox>

            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel x:Name="BestTimesStack" Margin="0,0,70,0">

                    <Viewbox Stretch="Fill" StretchDirection="DownOnly" MaxHeight="56">
                        <Label x:Name="BestTimeLbl" Content="{x:Static p:Resources.ProfilePage_BestTime}"
                               FontFamily="{StaticResource Elite}" FontSize="48"
                               Foreground="{StaticResource CreamBrush}"
                               HorizontalAlignment="Center" />
                    </Viewbox>

                    <ItemsControl ItemsSource="{Binding BestTimes}" Margin="0,26,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Label Content="{Binding}" FontFamily="{StaticResource Elite}" FontSize="46"
                                       Foreground="{StaticResource CreamMutedBrush}"
                                       HorizontalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel>

                    <Viewbox Stretch="Fill" StretchDirection="DownOnly" MaxHeight="56">
                        <Label x:Name="LeastTriesLbl" Content="{x:Static p:Resources.ProfilePage_LeastTries}"
                               FontFamily="{StaticResource Elite}" FontSize="48"
                               Foreground="{StaticResource CreamBrush}"
                               HorizontalAlignment="Center" />
                    </Viewbox>

                    <ItemsControl ItemsSource="{Binding LeastTries}" Margin="0,26,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Label Content="{Binding}" FontFamily="{StaticResource Elite}" FontSize="46"
                                       Foreground="{StaticResource CreamMutedBrush}"
                                       HorizontalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,0,0,44">

                <Viewbox Stretch="UniformToFill" MaxHeight="71">
                    <TextBox x:Name="ReportUsernameTxt" Style="{StaticResource MetalTextBox}"
                             FontFamily="{StaticResource Elite}" FontSize="40"
                             Width="459" Height="71" Padding="20,0"
                             Foreground="{StaticResource InkMutedBrush}"
                             Text="{Binding ReportedPlayer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             GotFocus="ReportUsernameTxt_GotFocus"
                             LostFocus="ReportUsernameTxt_LostFocus" />
                </Viewbox>

                <Button x:Name="ReportBtn" Style="{StaticResource MetalButtonRed}"
                        Width="45" Height="71" Padding="4,0" Margin="16,0,0,0"
                        FontFamily="{StaticResource Elite}" FontSize="36" Content="!"
                        Command="{Binding ReportCommand}" />
            </StackPanel>

            <Button x:Name="BackBtn" Grid.Row="3" Style="{StaticResource MetalButtonRed}"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource Elite}" FontSize="60"
                    Width="374" Height="124"
                    Content="{x:Static p:Resources.UI_Back}"
                    Command="{Binding BackCommand}" />
        </Grid>
    </Grid>
</Page>