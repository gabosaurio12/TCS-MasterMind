<Application x:Class="MasterMind_Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MasterMind_Client" >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette antes que Styles: los estilos referencian los sprites y pinceles. -->
                <ResourceDictionary Source="/Assets/Palette.xaml" />
                <ResourceDictionary Source="/Assets/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="Aladin">pack://application:,,,/Assets/Fonts/Aladin-Regular.ttf#Aladin</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>