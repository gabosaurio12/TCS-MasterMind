<UserControl x:Class="MasterMind_Client.Controls.NineSlice"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="400" d:DesignHeight="100">

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Las celdas de esquina y borde llevan su grosor explicitamente: son ellas
             las que dan el tamano a las filas y columnas Auto. Los rellenos los
             asigna NineSlice.xaml.cs, porque un Brush se recalcula al cambiar
             Source o Slice y un binding sobre una propiedad CLR no se entera. -->

        <Rectangle x:Name="TopLeftRect" Grid.Row="0" Grid.Column="0"
                   Width="{Binding Slice.Left, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                   Height="{Binding Slice.Top, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

        <Rectangle x:Name="TopRect" Grid.Row="0" Grid.Column="1"
                   Height="{Binding Slice.Top, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

        <Rectangle x:Name="TopRightRect" Grid.Row="0" Grid.Column="2"
                   Width="{Binding Slice.Right, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                   Height="{Binding Slice.Top, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

        <Rectangle x:Name="LeftRect" Grid.Row="1" Grid.Column="0"
                   Width="{Binding Slice.Left, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

        <Rectangle x:Name="FillRect" Grid.Row="1" Grid.Column="1" />

        <Rectangle x:Name="RightRect" Grid.Row="1" Grid.Column="2"
                   Width="{Binding Slice.Right, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

        <Rectangle x:Name="BottomLeftRect" Grid.Row="2" Grid.Column="0"
                   Width="{Binding Slice.Left, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                   Height="{Binding Slice.Bottom, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

        <Rectangle x:Name="BottomRect" Grid.Row="2" Grid.Column="1"
                   Height="{Binding Slice.Bottom, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

        <Rectangle x:Name="BottomRightRect" Grid.Row="2" Grid.Column="2"
                   Width="{Binding Slice.Right, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                   Height="{Binding Slice.Bottom, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
    </Grid>
</UserControl>