    <!-- ============================ Casilla ============================ -->

    <Style x:Key="MetalCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource CreamBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="CheckBoxBorder" Width="42" Height="42" CornerRadius="6"
                                Background="{StaticResource PaperBrush}"
                                BorderBrush="{StaticResource FrameMetalBrush}" BorderThickness="5"
                                VerticalAlignment="Center">
                            <Path x:Name="CheckMark" Data="M 2 8 L 7 13 L 16 2"
                                  Stroke="{StaticResource GoGreenBrush}" StrokeThickness="3"
                                  Stretch="Uniform" Margin="4" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Texto ============================ -->

    <Style x:Key="MetalTitleLbl" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource CreamBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MetalFieldLbl" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource CreamBrush}" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================ Paneles ============================ -->

    <!-- Aproximacion con Border: falta el asset del panel con marco metalico. -->
    <Style x:Key="MetalPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelOliveBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FrameMetalBrush}" />
        <Setter Property="BorderThickness" Value="8" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

</ResourceDictionary>