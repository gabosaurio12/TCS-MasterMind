<!-- =========================================================================
         TEMA "METAL CLASIFICADO"
         Sistema nuevo basado en los sprites 9-slice de Assets/Elements.
         Los estilos legacy de arriba siguen vivos: las paginas que todavia no
         se han migrado los siguen usando.
         ========================================================================= -->

    <!-- ============================ Botones ============================ -->

    <Style x:Key="MetalButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource CreamBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <controls:NineSlice Source="{TemplateBinding controls:NineSlice.SliceImage}" Slice="26" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.92" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MetalButtonBlue" TargetType="Button" BasedOn="{StaticResource MetalButton}">
        <Setter Property="controls:NineSlice.SliceImage" Value="{StaticResource BtnBlueImage}" />
    </Style>

    <Style x:Key="MetalButtonGreen" TargetType="Button" BasedOn="{StaticResource MetalButton}">
        <Setter Property="controls:NineSlice.SliceImage" Value="{StaticResource BtnGreenImage}" />
    </Style>

    <Style x:Key="MetalButtonRed" TargetType="Button" BasedOn="{StaticResource MetalButton}">
        <Setter Property="controls:NineSlice.SliceImage" Value="{StaticResource BtnRedImage}" />
    </Style>

    <Style x:Key="MetalButtonGrey" TargetType="Button" BasedOn="{StaticResource MetalButton}">
        <Setter Property="controls:NineSlice.SliceImage" Value="{StaticResource BtnGreyImage}" />
    </Style>

    <!-- ============================ Campos de texto ============================ -->

    <Style x:Key="MetalTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource CaretInkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="Transparent">
                        <controls:NineSlice Source="{StaticResource FieldImage}" Slice="24" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

