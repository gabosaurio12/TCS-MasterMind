<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Sprites (9-slice) ============================ -->

    <BitmapImage x:Key="BtnBlueImage" UriSource="/Assets/Elements/Blue_Button.png" />
    <BitmapImage x:Key="BtnGreenImage" UriSource="/Assets/Elements/Green_Button.png" />
    <BitmapImage x:Key="BtnRedImage" UriSource="/Assets/Elements/Red_Button.png" />
    <BitmapImage x:Key="BtnGreyImage" UriSource="/Assets/Elements/Grey_Button.png" />
    <BitmapImage x:Key="BtnBluePlusImage" UriSource="/Assets/Elements/Blue_Plus_Button.png" />
    <BitmapImage x:Key="BtnRedMinusImage" UriSource="/Assets/Elements/Red_Minus_Button.png" />
    <BitmapImage x:Key="BtnRedReportImage" UriSource="/Assets/Elements/Red_Report_Button.png" />
    <BitmapImage x:Key="FieldImage" UriSource="/Assets/Elements/TextBox.png" />

    <!-- ============================ Backgrounds ============================ -->

    <ImageBrush x:Key="BgLeftPanelBrush" ImageSource="/Assets/Backgrounds/LeftPanel_Dark.png" />
    <ImageBrush x:Key="BgLeftPanelGreenBrush" ImageSource="/Assets/Backgrounds/LeftPanel_Green.png" />
    <ImageBrush x:Key="BgRightPanelBrush" ImageSource="/Assets/Backgrounds/RightPanel_Light.png" />

    <!-- Modal panels, full frame included -->
    <ImageBrush x:Key="ModalErrorBgBrush"
                ImageSource="/Assets/Backgrounds/ErrorNotificationModal_Background.png" />
    <ImageBrush x:Key="ModalSuccessBgBrush"
                ImageSource="/Assets/Backgrounds/SuccessNotificationModal_Background.png" />
    <ImageBrush x:Key="ModalFriendsBgBrush"
                ImageSource="/Assets/Backgrounds/Friends_Background.png" />

    <!-- ============================ Illustrations ============================ -->

    <BitmapImage x:Key="LogoSource" UriSource="/Assets/Elements/MasterMind_Title.png" />
    <BitmapImage x:Key="MachineSource" UriSource="/Assets/Elements/DecipheringMachine.png" />
    <BitmapImage x:Key="AvatarImage" UriSource="/Assets/DefaultAvatar.png" />

    <ImageBrush x:Key="LogoBrush" ImageSource="{StaticResource LogoSource}"
                Stretch="UniformToFill"  />

    <ImageBrush x:Key="MachineBrush" ImageSource="{StaticResource MachineSource}"
                Stretch="UniformToFill"/>

    <!-- ============================ Colors ============================ -->

    <!-- Ink on parchment (inside the fields) -->
    <SolidColorBrush x:Key="PaperBrush" Color="#E8D5A8" />
    <SolidColorBrush x:Key="InkBrush" Color="#3B2F1E" />
    <SolidColorBrush x:Key="InkMutedBrush" Color="#6E5F49" />

    <!-- Ink on metal or olive panel (titles and labels) -->
    <SolidColorBrush x:Key="CreamBrush" Color="#F2E3BE" />
    <SolidColorBrush x:Key="CreamMutedBrush" Color="#CBB98C" />

    <!-- Panels -->
    <SolidColorBrush x:Key="PanelOliveBrush" Color="#2B3127" />
    <SolidColorBrush x:Key="PanelOliveDarkBrush" Color="#232820" />
    <SolidColorBrush x:Key="FrameMetalBrush" Color="#6E6E60" />

    <!-- Game semantics (also used by UtilsUI from code) -->
    <SolidColorBrush x:Key="InfoBlueBrush" Color="#3E6C93" />
    <SolidColorBrush x:Key="GoGreenBrush" Color="#5B7B3A" />
    <SolidColorBrush x:Key="AlertRedBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="NeutralGreyBrush" Color="#6E6A63" />

    <!-- Links -->
    <SolidColorBrush x:Key="LinkBrush" Color="#7C9BE8" />

    <!-- Text cursor inside the fields -->
    <SolidColorBrush x:Key="CaretInkBrush" Color="#3B2F1E" />
</ResourceDictionary>