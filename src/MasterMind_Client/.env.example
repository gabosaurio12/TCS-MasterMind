# Template for the environment variables required by MasterMind_Client.
# Copy this file to .env, fill the values and never commit the real .env (it is gitignored).
# The client loads it with DotNetEnv (Env.Load) from Data/MasterMindModel.Context.Custom.cs.

DB_SOURCE=(localdb)\MSSQLLocalDB
DB_NAME=MasterMind
DB_USER=MasterMind_Login
DB_PASSWORD=